---
import { getCollection } from 'astro:content';
import ResourceCard from '../components/ResourceCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig, textConfig } from '../config';

const listings = await getCollection('listings');
const listingsById = new Map(listings.map((listing) => [listing.id, listing]));
const featuredListings = siteConfig.featuredIds.map((id) => {
  const listing = listingsById.get(id);
  if (!listing) throw new Error(`Featured resource not found: ${id}`);
  return listing;
});
---

<BaseLayout title={textConfig.common.home}>
  <main id="main-content" class="home-page">
    <section class="intro-panel" aria-labelledby="home-title">
      <p class="eyebrow">{siteConfig.title}</p>
      <h1 id="home-title">{siteConfig.subtitle}</h1>
      <p class="intro-copy">{textConfig.home.intro}</p>

      <form class="home-search" action="/resources/" method="get" role="search">
        <label class="visually-hidden" for="resource-query">{textConfig.common.searchLabel}</label>
        <input
          id="resource-query"
          type="search"
          name="q"
          placeholder={textConfig.common.searchPlaceholder}
          autocomplete="off"
        />
        <button type="submit">
          <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
            <circle cx="10.8" cy="10.8" r="6.3" />
            <path d="m15.5 15.5 4.2 4.2" />
          </svg>
          <span>{textConfig.common.searchButton}</span>
        </button>
      </form>
      <p class="search-hint">{textConfig.home.searchHint}</p>
    </section>

    <section class="featured-section" aria-labelledby="featured-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">{textConfig.home.featuredEyebrow}</p>
          <h2 id="featured-title">{textConfig.home.featuredTitle}</h2>
        </div>
        <a class="all-resources-link" href="/resources/">{textConfig.home.viewAll} <span aria-hidden="true">→</span></a>
      </div>

      <div class="resource-grid">
        {featuredListings.map((entry) => <ResourceCard entry={entry} />)}
      </div>
    </section>
  </main>
</BaseLayout>
