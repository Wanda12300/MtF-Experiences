---
import { getCollection } from 'astro:content';
import ResourceSearch from '../../components/ResourceSearch.astro';
import { resourceCategories } from '../../content/categories/index';
import BaseLayout from '../../layouts/BaseLayout.astro';

const listings = await getCollection('listings');
const categoryOrder = new Map<string, number>(resourceCategories.map(({ slug, order }) => [slug, order]));
const orderedListings = [...listings].sort((left, right) =>
  (categoryOrder.get(left.data.category) ?? 0) - (categoryOrder.get(right.data.category) ?? 0)
  || left.data.name.localeCompare(right.data.name),
);
---

<BaseLayout title="资源目录">
  <main id="main-content" class="resources-page">
    <section class="intro-panel resources-intro" aria-labelledby="resources-title">
      <p class="eyebrow">MtF Experiences</p>
      <h1 id="resources-title">资源目录</h1>
      <p class="intro-copy">浏览上游页面收录的跨性别相关资源，或按名称和原有说明搜索。</p>
    </section>

    <aside class="history-note" aria-label="关于收录内容">
      <span class="note-mark" aria-hidden="true">i</span>
      <div>
        <h2>历史快照</h2>
        <p>条目名称、说明和分类沿用上游页面原有收录，未经独立复核。外部链接与商品信息可能已经变化，不应视为当前状态或医疗建议。</p>
      </div>
    </aside>

    <ResourceSearch entries={orderedListings} categories={resourceCategories} />
  </main>
</BaseLayout>
